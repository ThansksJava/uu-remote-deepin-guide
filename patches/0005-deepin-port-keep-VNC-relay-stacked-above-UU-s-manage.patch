From 1924654adc854898238ee447c68f903d754e0f44 Mon Sep 17 00:00:00 2001
From: fengjie <fengjie@local>
Date: Mon, 12 Oct 2026 09:40:44 +0800
Subject: [PATCH 5/6] deepin-port: keep VNC relay stacked above UU's management
 window

TigerVNC 1.15 retitles its top-level window from 'TigerVNC viewer' to
'<host>:<display> - TigerVNC' once connected, so the supervisor's
'^TigerVNC viewer$' lookup missed it and the cached relay window id went
stale. On top of that the restack guard required a non-empty
getactivewindow, which is always empty under Openbox here, so the relay
was never raised. UU's layered GameViewer.exe management window (mapped
after login) then stayed over the private display: a controller saw it
instead of the desktop and could never interact with it, since input is
injected straight onto the real desktop. Match 'TigerVNC' and raise the
relay unconditionally while no console-focus file is present.

Also route mouse events through the broker/x11 path by default (see
uu_input_bridge.c) so Wine's inability to deliver button events to the
native viewer no longer drops clicks.
---
 scripts/uu-remote-bridge | 22 ++++++++++++++++------
 src/uu_input_bridge.c    | 28 +++++++++++++++++++++++++++-
 2 files changed, 43 insertions(+), 7 deletions(-)

diff --git a/scripts/uu-remote-bridge b/scripts/uu-remote-bridge
index 79b1e25..6374206 100755
--- a/scripts/uu-remote-bridge
+++ b/scripts/uu-remote-bridge
@@ -1474,7 +1474,7 @@ else
             {
                 /usr/bin/xdotool search --onlyvisible \
                     --pid "$vncviewer_pid" \
-                    --name '^TigerVNC viewer$' \
+                    --name 'TigerVNC' \
                     2>/dev/null || true
             } | /usr/bin/tail -n 1
         )"
@@ -1575,7 +1575,7 @@ supervise_server() {
                     {
                         /usr/bin/xdotool search --onlyvisible \
                             --pid "$vncviewer_pid" \
-                            --name '^TigerVNC viewer$' \
+                            --name 'TigerVNC' \
                             2>/dev/null || true
                     } | /usr/bin/tail -n 1
                 )"
@@ -1586,11 +1586,21 @@ supervise_server() {
             active_window_id="$(
                 /usr/bin/xdotool getactivewindow 2>/dev/null || true
             )"
-            if [[ ! -e "$console_focus_file" && \
-                  -n "$active_window_id" && \
-                  "$active_window_id" != "$relay_window_id" ]]; then
-                /usr/bin/xdotool windowactivate "$relay_window_id" \
+            # deepin-port: TigerVNC is not an Openbox focus target, so
+            # getactivewindow can legitimately return empty here. The old
+            # guard required a non-empty active window and therefore never
+            # restacked the relay, which let UU's layered management window
+            # (GameViewer.exe, mapped later) sit on top of the captured
+            # desktop on the private display. Raise the relay unconditionally
+            # so only the live desktop is ever visible to a controller.
+            if [[ ! -e "$console_focus_file" ]]; then
+                /usr/bin/xdotool windowraise "$relay_window_id" \
                     >/dev/null 2>&1 || true
+                if [[ -n "$active_window_id" && \
+                      "$active_window_id" != "$relay_window_id" ]]; then
+                    /usr/bin/xdotool windowactivate "$relay_window_id" \
+                        >/dev/null 2>&1 || true
+                fi
             fi
         fi
         health_checks=$((health_checks + 1))
diff --git a/src/uu_input_bridge.c b/src/uu_input_bridge.c
index ed2794c..90eedbd 100644
--- a/src/uu_input_bridge.c
+++ b/src/uu_input_bridge.c
@@ -214,6 +214,32 @@ static BOOL contains_input_type(UINT count, const INPUT *inputs, int size,
     return FALSE;
 }
 
+/* The Deepin/VNC port captures a native TigerVNC viewer window that Wine
+ * cannot deliver mouse buttons to: the X11 driver reports success for button
+ * events it never forwards to a non-Wine window, so a controller can move the
+ * pointer but never click. Send mouse events through the broker by default so
+ * uu-x11-input injects them straight onto the live desktop; the Wine queue
+ * path is only used when the bridge explicitly opts in with
+ * UURB_INPUT_ROUTE=direct. */
+static BOOL mouse_uses_broker(void)
+{
+    static volatile LONG cached_state = -1;
+    wchar_t value[16];
+    LONG state;
+
+    state = InterlockedCompareExchange(&cached_state, 0, -1);
+    if (state >= 0)
+        return (BOOL)state;
+
+    state = 1;
+    if (GetEnvironmentVariableW(L"UURB_INPUT_ROUTE", value,
+                               (DWORD)(sizeof(value) / sizeof(value[0]))) > 0 &&
+        lstrcmpiW(value, L"direct") == 0)
+        state = 0;
+    InterlockedExchange(&cached_state, state);
+    return (BOOL)state;
+}
+
 static UINT WINAPI bridged_send_input(UINT count, LPINPUT inputs, int size)
 {
     char line[512];
@@ -255,7 +281,7 @@ static UINT WINAPI bridged_send_input(UINT count, LPINPUT inputs, int size)
                                             INPUT_KEYBOARD);
     mouse_input = !unicode_keyboard && !physical_keyboard &&
                   contains_input_type(count, inputs, size, INPUT_MOUSE);
-    if (unicode_keyboard) {
+    if (unicode_keyboard || (mouse_input && mouse_uses_broker())) {
         broker_started_ms = GetTickCount64();
         result = send_through_broker(count, inputs, size, &error);
         broker_ms = (DWORD)(GetTickCount64() - broker_started_ms);
