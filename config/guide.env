#!/usr/bin/env bash
# =============================================================================
# uu-remote-deepin-guide 统一配置
#
# 所有脚本都会自动读取本文件（scripts/*.sh、bin/*）。换机器时只改这里，
# 或者什么都不改——默认值都是自动探测的（用户名 / UID / 主机名 / 分辨率 /
# 私有屏号都不再写死）。
#
# 覆盖方式：命令行里 export 同名变量即可，例如
#   REPO_DIR=~/src/uu-remote-ubuntu-bridge bash scripts/02-install.sh
# =============================================================================

# ---- 目录与仓库 -------------------------------------------------------------
# 本指南目录（脚本会自动探测成脚本所在目录的上一层，一般不用改）
: "${GUIDE_DIR:=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}"
# 桥接仓库（deepin-port 分支）
: "${REPO_DIR:=$HOME/Desktop/uu-remote-ubuntu-bridge}"
# Wine 前缀
: "${WINE_PREFIX:=$HOME/.local/share/wineprefixes/uu-remote}"
# 脚本运行日志输出目录（原实现写死在 AI 会话目录里，已改为用户状态目录）
: "${LOG_DIR:=$HOME/.local/state/uu-deepin-port}"

# ---- Wine ------------------------------------------------------------------
: "${WINE_BIN:=/opt/wine-stable/bin/wine}"
: "${WINESERVER_BIN:=/opt/wine-stable/bin/wineserver}"

# ---- 种子源（★ 前置条件） ---------------------------------------------------
# 新前缀里的 UU 文件是从这里拷贝过去的。必须是一份**已认证的 UU 4.42.1.2835**
# 的 GameViewer 目录。本机取自 Spark 商店版 potplayer 前缀；换机时若没有这份
# 现成文件，就得自己准备（见 README「本机前置条件」一节）。
: "${SEED_SRC:=$HOME/.deepinwine/Spark-potplayer/drive_c/Program Files/Netease/GameViewer}"

# ---- 中继（VNC）参数 --------------------------------------------------------
# 被控的真实桌面（DDE 会话就是 :0）
: "${DESKTOP_TARGET:=:0}"
# 中继密码：只是本地回环 127.0.0.1:5922 用的口令，示例值，建议换成自己的
: "${RELAY_PASS:=uu123456}"
# 中继/抓屏分辨率："auto" = 用 xrandr 探测真实桌面当前分辨率
: "${RESOLUTION:=auto}"
# 私有屏（Xvfb）号："auto" = 读桥接服务写出的 private-display 文件
: "${PRIVATE_DISPLAY:=auto}"

# ---- 内部工具函数 -----------------------------------------------------------

# 桥接服务的运行时目录
uurb_runtime_dir() { echo "${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/uu-remote-bridge"; }

# 真实桌面显示号（被控目标）
uurb_desktop_display() { echo "${DESKTOP_TARGET:-:0}"; }

# 私有屏显示号：优先读桥接写出的状态文件，其次用显式配置，最后兜底 :20
uurb_private_display() {
    local f d
    f="$(uurb_runtime_dir)/private-display"
    if [ -f "$f" ]; then
        d="$(cat "$f" 2>/dev/null)"
        [ -n "$d" ] && { echo "$d"; return; }
    fi
    if [ -n "${PRIVATE_DISPLAY:-}" ] && [ "${PRIVATE_DISPLAY}" != auto ]; then
        echo "$PRIVATE_DISPLAY"; return
    fi
    echo ":20"
}

# 真实桌面的分辨率（1920x1200 这类值不再写死）
uurb_resolution() {
    local r d
    if [ -n "${RESOLUTION:-}" ] && [ "${RESOLUTION}" != auto ]; then
        echo "$RESOLUTION"; return
    fi
    d="$(uurb_desktop_display)"
    r="$(DISPLAY="$d" XAUTHORITY="${DESKTOP_XAUTHORITY:-$HOME/.Xauthority}" \
         xrandr --current 2>/dev/null | awk '/\*/{print $1; exit}')"
    if [ -z "$r" ]; then
        r="$(DISPLAY="$d" XAUTHORITY="${DESKTOP_XAUTHORITY:-$HOME/.Xauthority}" \
             xdpyinfo 2>/dev/null | awk '/dimensions:/{print $2; exit}')"
    fi
    echo "${r:-1920x1080}"   # 都探测不到时的兜底值
}

# 当前用户在 Wine 前缀里的目录名（= 建前缀时的 Linux 用户名，不再是写死的 fengjie）
uurb_wine_user() { echo "${WINE_USER:-$(id -un)}"; }

# 常用日志路径（DLL / broker / 光标守护）
uurb_wine_log() {
    local which="$1" u
    u="$(uurb_wine_user)"
    case "$which" in
        bridge) echo "$WINE_PREFIX/drive_c/users/$u/AppData/Local/Temp/uu-input-bridge.log" ;;
        broker) echo "$WINE_PREFIX/drive_c/users/$u/Temp/uu-input-broker.log" ;;
        cursor) echo "$WINE_PREFIX/drive_c/users/$u/AppData/Local/Temp/uu-cursor-guard.log" ;;
    esac
}
